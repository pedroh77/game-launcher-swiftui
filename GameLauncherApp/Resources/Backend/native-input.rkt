#lang racket
;; native-input-owner-v1: private, acknowledged mailbox; never parse game output.
(require json racket/file)
(provide native-input-enabled? native-input-request)
(define environment-key "GAME_LAUNCHER_NATIVE_INPUT")
(define sequence-number 0)
(define (native-input-enabled?) (and (getenv environment-key) #t))
(define (native-input-request action [coords #f])
  (define marker (string->jsexpr (or (getenv environment-key) "null")))
  (unless (and (hash? marker) (string? (hash-ref marker 'directory #f))
               (absolute-path? (hash-ref marker 'directory))
               (string? (hash-ref marker 'token #f)))
    (error 'native-input "Invalid native input owner; refusing legacy fallback"))
  (define directory (hash-ref marker 'directory))
  (define cancelled (build-path directory "cancelled"))
  (define response (build-path directory "response.json"))
  (define (check-owner)
    (unless (and (directory-exists? directory) (not (file-exists? cancelled)))
      (error 'native-input "Native focus cancelled or owner ended")))
  (check-owner)
  (set! sequence-number (add1 sequence-number))
  (define request (hasheq 'token (hash-ref marker 'token) 'sequence sequence-number
                          'action action 'coords (or coords 'null)
                          'createdAt (/ (current-inexact-milliseconds) 1000.0)))
  (define temporary (make-temporary-file ".request-~a" #f directory))
  (dynamic-wind void
    (lambda ()
      (call-with-output-file temporary (lambda (out) (write-json request out)) #:exists 'truncate)
      (rename-file-or-directory temporary (build-path directory "request.json") #t))
    (lambda () (when (file-exists? temporary) (delete-file temporary))))
  (define deadline (+ (current-inexact-monotonic-milliseconds) 5000))
  (let loop ()
    (check-owner)
    (define reply (and (file-exists? response)
                       (with-handlers ([exn:fail? (lambda (_) #f)])
                         (call-with-input-file response read-json))))
    (cond
      [(and (hash? reply) (equal? (hash-ref reply 'sequence #f) sequence-number))
       (unless (eq? (hash-ref reply 'ok #f) #t)
         (error 'native-input "~a" (hash-ref reply 'error "Native input refused")))]
      [(>= (current-inexact-monotonic-milliseconds) deadline)
       (when (directory-exists? directory)
         (call-with-output-file cancelled void #:exists 'truncate))
       (error 'native-input "Native input acknowledgement timed out; no legacy fallback")]
      [else (sleep 0.025) (loop)])))
